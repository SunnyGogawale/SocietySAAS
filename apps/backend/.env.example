NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/societysaas_dev
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
REQUEST_BODY_LIMIT=1mb
LOG_LEVEL=info
SESSION_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60
INVITATION_TTL_HOURS=24
EMAIL_VERIFICATION_REQUIRED=false
WEB_APP_URL=http://localhost:5173
EMAIL_FROM=SocietySAAS <no-reply@example.test>
# Optional until SMTP delivery is configured. Invitations require an active SMTP transport.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# Generate with: openssl rand -base64 32. Required before saving society Razorpay credentials.
PAYMENT_CREDENTIAL_ENCRYPTION_KEY=
