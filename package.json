{
  "name": "societysaas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "apps/backend",
    "packages/design-tokens"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @societysaas/web",
    "dev:mobile": "npm run dev --workspace @societysaas/mobile",
    "dev:backend": "npm run dev --workspace @societysaas/backend",
    "lint": "eslint .",
    "format": "prettier --write \"apps/**/*.{js,jsx,json,css,md}\" \"packages/**/*.{js,json,css}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"apps/**/*.{js,jsx,json,css,md}\" \"packages/**/*.{js,json,css}\" \"*.{js,json,md}\"",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2"
  }
}
